# Copy required values to Render > Web Service > Environment.
# Do not commit a real .env file or share secret values.

# Required
MONGODB_URI=
JWT_SECRET=
# Generate a long random value (at least 32 bytes).
PORT=8080

# App / security
JWT_EXPIRATION_MS=86400000
FRONTEND_ORIGIN=
PUBLIC_BASE_URL=
PABONAKI_SETUP_TOKEN=
PABONAKI_SEED_DEMO=false
DELIVERY_DHAKA=80
DELIVERY_OUTSIDE_DHAKA=130

# Email (Brevo HTTPS API)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=PaboNaki
SUPPORT_EMAIL=
# Optional legacy fallback
RESEND_API_KEY=
EMAIL_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# AI / Google login
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_CLIENT_ID=
AI_FEATURES_ENABLED=true
AI_EMBEDDING_MODEL=gemini-embedding-2
AI_EMBEDDING_DIMENSIONS=768
AI_DAILY_EMBEDDING_BUDGET=2000
AI_VISUAL_MAX_BYTES=4194304
AI_VISUAL_MIN_SCORE=0.35
AI_INDEX_AUTO=true
AI_INDEX_BATCH=20
AI_VECTOR_MODE=auto
AI_VECTOR_TEXT_INDEX=product_text_vector_index
AI_VECTOR_IMAGE_INDEX=product_image_vector_index
AI_RATE_VISUAL_PER_MIN=10
AI_RATE_SEMANTIC_PER_MIN=30

# Cloudinary product image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Pathao courier (sandbox by default)
PATHAO_BASE_URL=https://courier-api-sandbox.pathao.com
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_STORE_ID=
PATHAO_CITY_ID=
PATHAO_ZONE_ID=
PATHAO_AREA_ID=

# SSLCOMMERZ (sandbox by default)
SSLCOMMERZ_BASE_URL=https://sandbox.sslcommerz.com
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

# TryOnCloud (optional)
TRYONCLOUD_API_KEY=
